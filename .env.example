# Porta em que o servidor (Express + WebSocket) escuta.
PORT=3000

# Endereco de bind do servidor.
# 0.0.0.0 = escuta em todas as interfaces de rede da maquina (necessario
# para acesso via IP local da rede e para o ngrok encontrar o servidor).
# Troque para 127.0.0.1 se quiser restringir o acesso so a maquina local.
HOST=0.0.0.0
